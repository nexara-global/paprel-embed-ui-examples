# Copy to .env.local in this folder, then from repo root: npm run dev:component-lab
# .env.local is gitignored — never commit secrets.

# API origin for the Vite /v1 proxy (no path suffix)
VITE_PAPREL_API_BASE_URL=https://app.paprel.localhost:9000
VITE_PARTNER_DOMAIN=app.paprel.localhost

# Dev BFF only — read at vite startup; secret never bundled into the browser
APP_CONNECT_TOKEN_URL=
APP_CONNECT_CLIENT_ID=
APP_CONNECT_CLIENT_SECRET=
PARTNER_DOMAIN=app.paprel.localhost

# Usually auto-enabled for *.localhost; set if token exchange fails on TLS
# PAPREL_DEV_INSECURE_TLS=1
