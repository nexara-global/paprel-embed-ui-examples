# Browser-safe host configuration.
VITE_PAPREL_API_BASE_URL=https://app.paprel.localhost:9000
VITE_PARTNER_DOMAIN=app.partner.localhost
# Browser-safe switcher labels: entity-key:Display name, separated by commas.
VITE_PAPREL_ENTITIES=default:HarborStone:019126e9-ef58-7c83-a0a4-69f073468de2,anotherstone:AnotherStone:019e2223-3a00-78d3-be7a-6477af6bd32a

APP_CONNECT_TOKEN_URL=https://app.paprel.localhost:9000/v1/app-connect/oauth/token
APP_CONNECT_CLIENT_ID=
APP_CONNECT_CLIENT_SECRET=
PARTNER_DOMAIN=app.partner.localhost

# Each additional entity uses a separate App Connect client. Token URL and partner
# domain fall back to the shared values above when omitted.
APP_CONNECT_ENTITY_ANOTHERSTONE_CLIENT_ID=
APP_CONNECT_ENTITY_ANOTHERSTONE_CLIENT_SECRET=
# APP_CONNECT_ENTITY_ANOTHERSTONE_TOKEN_URL=https://app.paprel.localhost:9000/v1/app-connect/oauth/token
# APP_CONNECT_ENTITY_ANOTHERSTONE_PARTNER_DOMAIN=app.partner.localhost

# Usually automatic for *.localhost. Enable for an untrusted local certificate.
# PAPREL_DEV_INSECURE_TLS=1
