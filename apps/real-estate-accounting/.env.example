# Browser-safe host configuration.
# Sandbox by default. Production is https://api.paprel.com.
VITE_PAPREL_API_BASE_URL=https://api-sandbox.paprel.com
VITE_PARTNER_DOMAIN=app.partner.localhost
# Browser-safe switcher labels: entity-key:Display name, separated by commas.
VITE_PAPREL_ENTITIES=default:Acme Property Group,second:Second Property Group

APP_CONNECT_TOKEN_URL=https://api-sandbox.paprel.com/v1/app-connect/oauth/token
APP_CONNECT_CLIENT_ID=
APP_CONNECT_CLIENT_SECRET=
PARTNER_DOMAIN=app.partner.localhost

# Each additional entity uses a separate App Connect client. Token URL and partner
# domain fall back to the shared values above when omitted.
APP_CONNECT_ENTITY_SECOND_CLIENT_ID=
APP_CONNECT_ENTITY_SECOND_CLIENT_SECRET=
# APP_CONNECT_ENTITY_SECOND_TOKEN_URL=https://api-sandbox.paprel.com/v1/app-connect/oauth/token
# APP_CONNECT_ENTITY_SECOND_PARTNER_DOMAIN=app.partner.localhost

# Partner API mode (optional). Setting PAPREL_PARTNER_CLIENT_ID replaces the App Connect
# values above: one partner credential mints a session per user and company. Keep the private
# key on the server, on one line with literal \n separators. VITE_PARTNER_DOMAIN must be your
# partner identity domain.
# PAPREL_API_BASE_URL=https://api-sandbox.paprel.com
# PAPREL_PARTNER_CLIENT_ID=
# PAPREL_PARTNER_KID=
# PAPREL_PARTNER_PRIVATE_KEY_PEM=
# PAPREL_PARTNER_ENTITY_DEFAULT_COMPANY_ID=
# PAPREL_PARTNER_ENTITY_DEFAULT_EXTERNAL_USER_ID=
# PAPREL_PARTNER_ENTITY_SECOND_COMPANY_ID=
# PAPREL_PARTNER_ENTITY_SECOND_EXTERNAL_USER_ID=

# Usually automatic for *.localhost. Enable for an untrusted local certificate.
# PAPREL_DEV_INSECURE_TLS=1
