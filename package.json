{
  "name": "paprel-embed-ui-examples",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:component-lab": "npm run dev -w @paprel-examples/component-lab",
    "dev:accounting": "npm run dev -w @paprel-examples/accounting-dashboard",
    "dev:real-estate": "npm run dev -w @paprel-examples/real-estate-accounting",
    "build:component-lab": "npm run build -w @paprel-examples/component-lab",
    "build:accounting": "npm run build -w @paprel-examples/accounting-dashboard",
    "build:real-estate": "npm run build -w @paprel-examples/real-estate-accounting",
    "build": "npm run build:component-lab && npm run build:accounting && npm run build:real-estate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@paprel/embed-accounting": "file:../paprel-embed-ui/packages/accounting",
    "@paprel/embed-core": "file:../paprel-embed-ui/packages/core",
    "@paprel/embed-reports": "file:../paprel-embed-ui/packages/reports",
    "@paprel/embed-ui": "file:../paprel-embed-ui/packages/ui"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
